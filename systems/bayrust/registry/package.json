{
  "name": "@krackedui/bayrust",
  "version": "0.0.0",
  "description": "Bayrust: a dark-first, keyboard-driven React design system built around a command surface.",
  "license": "UNLICENSED",
  "private": true,
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "SYSTEM.md",
    "LICENSES"
  ],
  "scripts": {
    "build": "node build/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "node ../../../standard/gate/verify.mjs bayrust"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "tokens",
    "ui"
  ],
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "esbuild": "0.25.5",
    "typescript": "5.8.3"
  }
}
