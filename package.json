{
  "name": "krackedui",
  "private": true,
  "type": "module",
  "scripts": {
    "docs": "npm run dev -w @krackedui/docs",
    "playground": "npm run dev -w @krackedui/motion-playground",
    "build:motion": "npm run build -w @krackedui/motion",
    "docs:assets": "node tooling/pipeline/package-exports.cjs motion && node tooling/pipeline/source-registry.mjs motion && node standard/gate/checks/build-llms.mjs motion && node tooling/pipeline/build-templates.mjs motion",
    "tokens:motion": "node systems/motion/tooling/tokens.mjs",
    "icons:motion": "node systems/motion/tooling/icons.mjs",
    "check:snippets": "node standard/gate/checks/check-snippets.mjs motion",
    "test:package": "node standard/gate/checks/smoke-test-package.mjs motion",
    "sweep:render": "node standard/gate/checks/sweep-render.mjs motion",
    "sweep:copy-paste": "node standard/gate/checks/sweep-copy-paste.mjs motion",
    "sweep:docs": "node standard/gate/checks/sweep-docs-pages.mjs motion",
    "gate": "node standard/gate/run.mjs",
    "gate:verify": "node standard/gate/verify.mjs",
    "gate:update-baselines": "node standard/gate/run.mjs --only visual --update-baselines"
  },
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "axe-core": "4.10.3",
    "esbuild": "0.25.5",
    "eslint": "9.29.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "26.1.0",
    "lucide-static": "0.525.0",
    "pixelmatch": "7.1.0",
    "playwright": "1.55.0",
    "pngjs": "7.0.0",
    "rea-agents": "6.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.0",
    "vitest": "3.2.4"
  },
  "workspaces": [
    "standard/contract",
    "systems/*/registry",
    "systems/*/playground",
    "systems/*/templates/*",
    "apps/*",
    "packages/*"
  ]
}
